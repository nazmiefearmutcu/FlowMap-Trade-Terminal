# Rust / Tauri build outputs
src-tauri/target/
src-tauri/gen/

# Bundled Python runtime + download cache (large binaries; rebuilt by
# scripts/bundle-python.sh, shipped in the DMG via the GitHub Release — not git)
src-tauri/resources/pyruntime/
src-tauri/resources/.cache/
# What the last bundle-python.sh run excluded, handed to the import gate in a
# later step (see app/scripts/import-gate.py). Build output, not source.
src-tauri/resources/.import-skip

# The Tauri icon set (src-tauri/icons) is tracked: it is generated from
# ../icons/icon-1024.png by `cargo tauri icon` (scripts/build-dmg.sh regenerates
# it), and a clean clone must be able to build without running that tool first.

# Built artifacts
*.dmg
*.app

# Node (if a package.json is ever added here)
node_modules/
